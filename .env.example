# Copia este archivo a .env y elige una contraseña para desarrollo local.
# .env está ignorado por Git; .env.example no contiene credenciales reales.
POSTGRES_DB=taller_backend
POSTGRES_USER=taller_user
POSTGRES_PASSWORD=cambia_esta_clave_local
POSTGRES_PORT=5432
# URL acordada para la API dentro de Docker (servicio de base de datos: db).
# El rol 3 configurará su lectura; fuera de Docker el host será localhost.
DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}
